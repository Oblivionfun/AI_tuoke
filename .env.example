# 冠维获客工作台 v2：复制为 .env 后填写。v1（tuoke 命令）的配置样例在 docs/archive-v1/env.v1.example。

# 模型。二选一：
# A. 公司 AIHub 网关（需要在公司内网）：走 OpenAI 透传 Responses 接口，支持联网搜索和结构化输出。
#    不要用 /standard/v1/chat/completions，那里工具调用和联网搜索都返回 400。
# WB_LLM_BASE_URL=http://api.aihub.woa.com/v1
# WB_LLM_PROVIDER=openai
# WB_LLM_API_KEY=
# WB_MODEL=gpt-6.1-sol
# B. OpenAI 官方：
OPENAI_API_KEY=

# 网站域名（Caddy 自动申请 HTTPS 证书），以及会话签名密钥（随机长字符串）
DOMAIN=workbench.example.com
WB_SESSION_SECRET=change-me-to-a-long-random-string
WB_COOKIE_SECURE=true

# 模型：先全部用最强模型 + 高推理档建立基线，评测集稳定后再逐个环节试降。型号以 OpenAI 官网为准。
WB_MODEL=gpt-5.5
WB_REASONING_EFFORT=high
# WB_MODEL_WRITER=        # 例如以后把文案降到便宜模型
# WB_MODEL_JUDGE=

# 三条底线之一：花费上限
WB_DAILY_CANDIDATE_LIMIT=40
WB_DAILY_REVIEW_LIMIT=10
WB_RESEARCH_CONCURRENCY=4
WB_MAX_TURNS_RESEARCHER=30

# 价格（美元 / 百万 token），按 OpenAI 官网价格填写后，运行页才会显示 token 花费；联网搜索按每次 0.01 美元计。
WB_PRICE_INPUT_PER_MTOK=0
WB_PRICE_CACHED_INPUT_PER_MTOK=0
WB_PRICE_OUTPUT_PER_MTOK=0

# 邮件签名（文案 agent 原样使用，空着的不会编造）
WB_SELLER_CONTACT_NAME=
WB_SELLER_EMAIL=
WB_SELLER_WHATSAPP=
WB_SELLER_WEBSITE=

# 本地开发时的数据库位置（Docker 里固定为 /data/workbench.db）
WB_DATABASE_URL=sqlite:///data/workbench.db
